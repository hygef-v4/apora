{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "db:dev"],
      "cwd": "backend",
      "port": 5433
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "backend",
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "4321",
        "--dart-define=API_BASE_URL=http://localhost:3000/api"
      ],
      "cwd": "mobile",
      "port": 4321
    }
  ]
}

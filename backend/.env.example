# ============================================
# APORA Backend - Environment Variables
# ============================================
# Copy file này thành .env và điền thông tin thật
# KHÔNG BAO GIỜ commit file .env lên Git!
# ============================================

# --- Database (PostgreSQL via Supabase Pooler) ---
# Dùng Transaction Pool (port 6543) cho serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- JWT Secret ---
# Dùng để ký và xác thực JWT Token
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-key-here"

# --- Cloudinary (Lưu trữ hình ảnh) ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- PayOS (Cổng thanh toán) ---
PAYOS_CLIENT_ID="your_client_id"
PAYOS_API_KEY="your_api_key"
PAYOS_CHECKSUM_KEY="your_checksum_key"

# --- Pusher (Realtime Chat - UC15) ---
PUSHER_APP_ID="your_app_id"
PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="ap1"

# --- Firebase Admin SDK (Push Notification - UC14) ---
# Đường dẫn tới file JSON service account
FIREBASE_SERVICE_ACCOUNT_KEY="./firebase-service-account.json"

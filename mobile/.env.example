API_BASE_URL=http://10.0.2.2:3000/api
# API_BASE_URL=http://localhost:3000/api (Web/iOS Simulator)

# Pusher Config
PUSHER_KEY=your_key
PUSHER_CLUSTER=ap1

# --- Firebase Phone Auth (UC03: quên mật khẩu qua SMS OTP) ---
# Không cần biến .env: cấu hình nằm ở lib/firebase_options.dart +
# android/app/google-services.json (và GoogleService-Info.plist cho iOS).
# Yêu cầu deploy:
#  - Bật provider "Phone" trong Firebase Console > Authentication.
#  - Android: khai báo SHA-1 & SHA-256 của app trong Firebase (bắt buộc để
#    reCAPTCHA/SafetyNet gửi được SMS).
#  - iOS: cấu hình APNs + URL scheme reversed client id.
# ==============================================================================
# APORA - Monorepo Gitignore
# ==============================================================================

# =========================
# FLUTTER / DART (Mobile App)
# =========================
mobile/.dart_tool/
mobile/.packages
mobile/.pub/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.metadata

# Dart generated
*.dart.js
*.info.json
*.js.map
*.js_
*.snapshot
*.dill

# Android/iOS specific (inside mobile)
mobile/android/.gradle/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/.last_build_id
mobile/ios/Flutter/ephemeral/
mobile/ios/DerivedData/

# Desktop platforms
mobile/macos/Flutter/ephemeral/
mobile/linux/flutter/ephemeral/
mobile/windows/flutter/ephemeral/

# Keystores
*.jks
*.keystore
mobile/android/key.properties

# =========================
# NEXT.JS / NODE.JS (Backend)
# =========================
backend/node_modules/
backend/.next/
backend/out/
backend/build/

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# ENVIRONMENT VARIABLES
# =========================
# (Bảo mật: Tuyệt đối không commit credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# =========================
# IDEs & OS Files
# =========================
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# =========================
# Firebase Logs
# =========================
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/
# Dev database (embedded-postgres)
backend/db/pgdata/

# Kotlin / Gradle logs
.kotlin/
**/errors-*.log

# Flutter platform generated files
**/generated_plugin_registrant.cc
**/generated_plugins.cmake
**/GeneratedPluginRegistrant.swift
**/GeneratedPluginRegistrant.objc
**/generated_plugin_registrant.h

serviceAccountKey.json
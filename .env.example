# ============================================
# APORA - Environment Variables (Root Level)
# ============================================

# Đây là file biến môi trường gốc cho toàn bộ monorepo nếu cần script tự động hóa.
# Biến môi trường chi tiết của Backend nằm ở: backend/.env.example
# Biến môi trường của Mobile nằm ở: (quản lý qua Dart Define hoặc envied)

# Mẫu tham khảo chung:
API_BASE_URL="http://localhost:3000/api"
